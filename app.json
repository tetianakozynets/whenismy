{
  "expo": {
    "name": "whenIsMy",
    "slug": "whenismy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "whenismy",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whenismy"
    },
    "android": {
      "package": "app.whenismy"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#e94560",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
