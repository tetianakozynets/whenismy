{
  "expo": {
    "name": "WIM",
    "slug": "whenismy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "whenismy",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.whenismy"
    },
    "android": {
      "package": "app.whenismy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e94560"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#e94560",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8ef8d1a-e5c5-4109-a606-b1a8a41b43aa"
      }
    },
    "owner": "tetianako"
  }
}
